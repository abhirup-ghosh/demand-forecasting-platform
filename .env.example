# Copy to `.env` (gitignored — never commit it) and fill in real values.

# --- Kaggle API credentials (needed for `make data`) ---
# Get these from https://www.kaggle.com/settings -> API -> "Create New Token".
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-key

# --- Optional overrides for forecasting_platform.config.Settings ---
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed
# MLFLOW_TRACKING_URI=sqlite:///mlruns.db
