# --- Data (never commit Kaggle data — redistribution violates competition rules) ---
data/raw/
data/processed/
data/interim/
*.csv
!tests/fixtures/**/*.csv
!data/README.md

# --- Secrets / credentials ---
.env
.env.*
!.env.example
kaggle.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- uv ---
uv.lock.bak

# --- MLflow / experiment artifacts ---
mlruns/
mlartifacts/
*.mlflow

